# Postgres (Supabase). Use the POOLED string (port 6543, ?pgbouncer=true)
# for the app; migrations need the DIRECT string (port 5432).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection, used only by migrations.
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"
AICREDITS_API_KEY=""
AICREDITS_MODEL="claude-sonnet-5"
RISK_WEIGHTS_JSON=""
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ── Auth (Supabase). Leave unset to run in single-user demo mode. ────────────
# When both are set, /login is enforced and ctx.user is the signed-in user.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── Alert email delivery (Resend). Unset = alerts stay in the in-app bell. ───
RESEND_API_KEY=""
ALERT_EMAIL_FROM="alerts@yourdomain.com"
# Absolute base URL used for links inside alert emails.
APP_URL="http://localhost:3000"

# Set to 1 for local Inngest dev mode (otherwise /api/inngest needs a signing key).
INNGEST_DEV="1"

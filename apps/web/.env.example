# Postgres (Supabase). Use the POOLED string (port 6543, ?pgbouncer=true)
# for the app; migrations need the DIRECT string (port 5432).
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"

DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"
AICREDITS_API_KEY=""
AICREDITS_MODEL="claude-sonnet-5"
RISK_WEIGHTS_JSON=""
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""



RESEND_API_KEY=""
ALERT_EMAIL_FROM="alerts@yourdomain.com"

APP_URL="http://localhost:3000"


INNGEST_DEV="1"

# ── OSINT sources (all work without keys; these raise limits / set etiquette) ─
# SEC requires a declared User-Agent identifying you, e.g. "Jane Doe jane@example.com".
# Without it SEC throttles or blocks, and that collector silently returns nothing.
SEC_EDGAR_USER_AGENT=""
# Optional: raises CourtListener API rate limits.
# https://www.courtlistener.com/help/api/
COURTLISTENER_API_TOKEN=""
